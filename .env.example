# =============================================================================
#  One2One Chat — environment configuration
#  Copy to .env (`cp .env.example .env`) and run `php artisan key:generate`.
# =============================================================================

APP_NAME="One2One Chat"
APP_ENV=local
APP_KEY=
# Always false in production (stack traces would leak internals).
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=one_to_one_chat
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true (HTTPS only)
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (password reset emails). "log" writes emails to storage/logs/laravel.log ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Laravel Reverb (WebSocket server) ---
# Generate credentials with `php artisan reverb:install` or use long random strings.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Host/port/scheme the BROWSER and the app use to reach Reverb (public address in production).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Interface/port the Reverb process listens on.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma-separated list of allowed origins in production, e.g. chat.example.com
REVERB_ALLOWED_ORIGINS=*

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Chat application settings ---
CHAT_MESSAGES_PER_PAGE=30
CHAT_MAX_IMAGE_KB=5120
CHAT_MAX_DOCUMENT_KB=10240
CHAT_MAX_VOICE_KB=10240
CHAT_MAX_AVATAR_KB=2048
CHAT_ONLINE_THRESHOLD_SECONDS=120
# 0 = no time limit
CHAT_EDIT_WINDOW_MINUTES=0
CHAT_DELETE_FOR_EVERYONE_WINDOW_MINUTES=0
# AJAX polling interval used while the WebSocket connection is unavailable
CHAT_POLLING_INTERVAL_MS=4000
# Nonce-based Content-Security-Policy (automatically skipped while `npm run dev` is running)
CHAT_CSP=true

# --- Android app push notifications (Firebase Cloud Messaging, free) ---
# Path to the Firebase service-account JSON (keep it outside public/). Empty = the app
# uses its own background connection instead. See mobile/README.md.
FCM_CREDENTIALS=
# Optional, read from the service-account file when empty
FCM_PROJECT_ID=

# --- Android app fallback connection (phones without Firebase push) ---
# How often the app checks for new messages while the WebSocket (Reverb) is unreachable
CHAT_MOBILE_POLL_SECONDS=60
# false = phone notifications say "New message" instead of showing the text
CHAT_MOBILE_NOTIFICATION_PREVIEW=true

# --- Initial administrator (created/updated by `php artisan db:seed`) ---
ADMIN_NAME="Administrator"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+10000000000
# Leave empty to generate a random password (printed once by the seeder).
ADMIN_PASSWORD=
