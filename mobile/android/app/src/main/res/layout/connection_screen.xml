<?xml version="1.0" encoding="utf-8"?>
<!-- Shown over the WebView when a page takes too long to load (slow or no internet). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:contentDescription="@null"
            android:src="@drawable/splash_icon" />

        <ProgressBar
            android:id="@+id/connection_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/brand" />

        <TextView
            android:id="@+id/connection_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/slow_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connection_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxWidth="320dp"
            android:text="@string/slow_message"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/connection_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/brand"
            android:minWidth="200dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/try_again"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
