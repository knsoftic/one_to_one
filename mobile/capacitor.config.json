{
    "appId": "com.hunario.chat",
    "appName": "One2One Chat",
    "webDir": "www",
    "server": {
        "url": "https://chat.hunario.com",
        "errorPath": "offline.html",
        "androidScheme": "https",
        "cleartext": false
    },
    "android": {
        "appendUserAgent": "One2OneApp/1.0",
        "allowMixedContent": false,
        "captureInput": false,
        "webContentsDebuggingEnabled": false
    },
    "plugins": {
        "SystemBars": {
            "insetsHandling": "disable",
            "initialViewportFitValueHint": "cover"
        }
    }
}
